---
import { getCollection, type CollectionEntry } from "astro:content";

import Layout from "../components/global.astro";
import Nav from "../components/nav.astro";
import Little from "../components/blogLittle.astro";

const posts = await getCollection("blog");

const options: Intl.DateTimeFormatOptions = {
    month: "long", // Use 'short' for abbreviated (e.g., Oct) or 'numeric' for numbers
    day: "numeric",
};
---

<!doctype html>
<html>
    <head>
        <Layout title="Blogs and News" />
    </head>
    <body>
        <Nav />
        <div class="container-fluid">
            {
                posts.map((i) => (
                    <Little>
                        <a href={`/blog/${i.data.slug}`}>
                            <h3>{i.data.title}</h3>
                        </a>
                        {i.data.desc}
                        <p style="color: #6b6b6b">
                            {new Date(i.data.pubDate).toLocaleString("en-US", {
                                month: "long",
                                day: "numeric",
                                year: "numeric",
                            })}
                            , by {i.data.author}
                        </p>
                    </Little>
                ))
            }
        </div>
    </body>
</html>
